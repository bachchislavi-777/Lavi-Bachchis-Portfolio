---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CaseArt from '../../../components/CaseArt.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getCopy, setRegion, localise, REGIONS } from '../../../lib/region.js';
setRegion(Astro.params.region);
const copy = getCopy();
import { ALL } from '../../../data/brands.js';
import { url } from '../../../lib/url.js';
import { varStyle, idBoard, feed, creatives } from '../../../lib/tiles.js';
import { caseSchema } from '../../../lib/schema.js';

export function getStaticPaths() {
  return REGIONS.flatMap((region) => ALL.map((b, i) => ({ params: { region, id: b.id }, props: { i } })));
}
const { i } = Astro.props;
const all = localise(ALL);
const b = all[i];
const c = copy.cases[b.id];
const seo = copy.seo[b.id];
const next = all.find((x) => x.id === c.nextCase);
const nc = copy.cases[next.id];
const num = String(i + 1).padStart(2, '0');
const typeLabel = (t) => (t === 'own' ? copy.work.ownLabel : t === 'product' ? 'Product brand' : 'Service brand');
const groupLabel = typeLabel(c.type);
const path = `/work/${b.id}/`;
const crumbs = [{ name: 'Work', path: '/work/' }, { name: c.name, path }];
const noteLabel = b.own ? copy.work.ownLabel : copy.work.sampleLabel;
const noteText = b.own ? copy.work.ownNote : copy.site.footerNote;
const briefBy = b.own ? `In my words · ${copy.site.name}, founder` : `Sample client brief · ${c.name}, ${c.location}`;
// Articles for this case: own projects by tag (the brand's name), sample brands by the post's caseStudy field.
const related = await getCollection('blog', ({ data }) => !data.draft && data.regions.includes(Astro.params.region) && (b.own ? data.tags.includes(c.name) : data.caseStudy === b.id));
---
<Layout title={seo.title} description={seo.description} path={path} current="/work/" brandFonts
  breadcrumbs={crumbs} schema={[caseSchema(Astro.site, b.id)]}>
  <div style={varStyle(b)}>
    <header class="hero phead case-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={url('/')}>Home</a></li>
            <li><a href={url('/work/')}>Work</a></li>
            <li><span aria-current="page">{c.name}</span></li>
          </ol>
        </nav>
        <div class="ch-head">
          <span class="ch-num" aria-hidden="true">{num}</span>
          <div>
            <span class="eyebrow">{groupLabel} · {c.sector}</span>
            <h1>{c.name}{c.h1Sub && <span class="h1-sub"><span class="sr-only">: </span>{c.h1Sub}</span>}</h1>
            <div class="chan">{c.channels}</div>
          </div>
          <div class="ch-meta">
            <p class="lede" style="margin-top:0;font-size:18px">{c.summary}</p>
            <dl>
              <dt>Sector</dt><dd>{c.sector}</dd>
              <dt>Based</dt><dd>{c.location}</dd>
              <dt>Channels</dt><dd>{c.channels}</dd>
            </dl>
          </div>
        </div>
        <p class="sample-note"><b>{noteLabel}</b><span>{noteText}</span></p>
        {c.links && <p class="case-links">{c.links.map((l) => <a class="btn ghost sm" href={l.url} rel="noopener" target="_blank">{l.label}<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a>)}</p>}
      </div>
    </header>

    <section class="band light" aria-labelledby="brief-h">
      <div class="wrap">
        <h2 class="sr-only" id="brief-h">The brief</h2>
        <div class="ch-hero">
          <div class="ch-photo">
            <CaseArt brand={b} sizes="(min-width: 1000px) 660px, 100vw" eager />
            <div class="idc id-logo" aria-label={`${c.name} logo and tagline`} role="group"><span class="lbl" style="font-family:var(--f-m);font-size:11px;text-transform:uppercase;letter-spacing:.1em;opacity:.7">Logo &amp; tagline</span><div set:html={b.logo} /><div class="tagl">{b.tagline}</div></div>
          </div>
          <div class="ch-brief">
            <span class="eyebrow">The brief</span>
            <blockquote><p>{c.brief}</p></blockquote>
            <span class="who">{briefBy}</span>
          </div>
        </div>
        <div class="ch-cols" style="margin-top:16px">
          <div class="ch-card"><span class="eyebrow">01 · Challenge</span><h3>The <em>challenge</em></h3><p>{c.challenge}</p></div>
          <div class="ch-card"><span class="eyebrow">02 · Approach</span><h3>The <em>approach</em></h3><ol>{c.approach.map((a) => <li><span>{a}</span></li>)}</ol></div>
          <div class="ch-card"><span class="eyebrow">03 · Deliverables</span><h3>What I <em>made</em></h3><ul>{c.deliverables.map((d) => <li><span>{d}</span></li>)}</ul></div>
        </div>
        {c.note && <p class="case-note"><b>Please note</b><span>{c.note}</span></p>}
      </div>
    </section>

    <section class="band case-band" aria-labelledby="id-h">
      <div class="wrap">
        <div class="panel">
          <div class="case-sec">
            <span class="eyebrow">Identity</span>
            <h2 class="sec-h" id="id-h" style="margin-top:10px">Brand <em>identity board</em></h2>
            <Fragment set:html={idBoard(b, 3)} />
          </div>
          <div class="case-sec">
            <span class="eyebrow">Instagram</span>
            <h2 class="sec-h" style="margin-top:10px">The planned <em>feed</em></h2>
            <Fragment set:html={feed(b, 3, '#id-h')} />
          </div>
          <div class="case-sec">
            <Fragment set:html={creatives(b, 2, 3).replace('class="ttl">Posts in', 'class="ttl sec-h" style="margin:0">Posts in')} />
          </div>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="band light" aria-labelledby="reads-h">
        <div class="wrap">
          <h2 class="mini-h" id="reads-h">Read the <em>articles</em></h2>
          <ul class="posts">
            {related.map((p) => (
              <li>
                <article class="post-card">
                  <span class="eyebrow">{p.data.tags[0]}</span>
                  <h3><a href={url(`/insights/${p.id}/`)}>{p.data.title}</a></h3>
                  <p>{p.data.excerpt}</p>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="band light" aria-labelledby="next-h">
      <div class="wrap">
        <h2 class="eyebrow" id="next-h" style="margin-bottom:18px">Next case study</h2>
        <a class="next" href={url(`/work/${next.id}/`)}>
          <span class="next-txt">
            <small>{typeLabel(nc.type)} · {nc.sector}</small>
            <strong>{nc.name}</strong>
            <span>{nc.summary}</span>
            <span class="btn" style="align-self:flex-start;margin-top:10px">{copy.work.cardCta} <span aria-hidden="true">→</span></span>
          </span>
          <span class="next-img"><CaseArt brand={next} sizes="(min-width: 620px) 50vw, 100vw" decorative /></span>
        </a>
        <p style="margin-top:22px"><a href={url('/work/')} class="btn ghost">All work</a></p>
      </div>
    </section>
  </div>
  <CtaBand />
</Layout>
