---
import Layout from '../layouts/Layout.astro';
import { getCopy, setRegion } from '../lib/region.js';
setRegion('uk');
const copy = getCopy();
import { url } from '../lib/url.js';
const n = copy.notFound;
---
<Layout title="Page not found | Lavi Bachchis" description={n.text} path="/404/" noindex>
  <header class="hero phead nf">
    <div class="wrap">
      <span class="eyebrow">404 · Page not found</span>
      <h1>{n.h1}</h1>
      <p class="lede">{n.text}</p>
      <div class="cta">
        <a class="btn" href={url('/work/')}>See the work</a>
        <a class="btn ghost" href={url('/services/')}>Services</a>
        <a class="btn ghost" href={url('/contact/')}>Get in touch</a>
      </div>
    </div>
  </header>
</Layout>
