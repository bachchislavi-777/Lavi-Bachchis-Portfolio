---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { getCopy, setRegion, localise, REGIONS } from '../../lib/region.js';
setRegion(Astro.params.region);
const copy = getCopy();
export const getStaticPaths = () => REGIONS.map((region) => ({ params: { region } }));
import { url } from '../../lib/url.js';
import { PUBLIC_WEB3FORMS_KEY, PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_KEY } from '../../data/settings.js';
const c = copy.contact;
const s = copy.site;
const L = c.labels;
const w3Key = (PUBLIC_WEB3FORMS_KEY || '').trim();
const sbUrl = (PUBLIC_SUPABASE_URL || '').trim().replace(/\/+$/, '');
const sbKey = (PUBLIC_SUPABASE_KEY || '').trim();
const formOn = Boolean(w3Key || (sbUrl && sbKey));
const region = Astro.params.region;
const contactPage = {
  '@type': 'ContactPage',
  name: copy.seo.contact.title.replace(/ \| Lavi Bachchis$/, ''),
  url: new URL(url('/contact/'), Astro.site).href,
  mainEntity: { '@id': `${new URL('/', Astro.site).href}#person` },
};
---
<Layout title={copy.seo.contact.title} description={copy.seo.contact.description} path="/contact/" current="/contact/"
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]} schema={[contactPage]}>
  <PageHead eyebrow={c.eyebrow} h1={c.h1} h1Em={c.h1Em} intro={c.intro} crumbs={[{ name: 'Contact', path: '/contact/' }]} />

  <section class="band terra" aria-labelledby="reach-h">
    <div class="wrap contact-grid">
      <div class="promise">
        <h2 class="eyebrow" id="reach-h">Get in touch</h2>
        <p class="big">{c.promise}</p>
        <p style="color:var(--mt)">{s.coverage} {c.hours}</p>
      </div>
      <div class="card">
        <div class="crow"><div><small>{L.name}</small><span class="v">{s.name}</span></div></div>
        <div class="crow"><div><small>{L.email}</small><a href={`mailto:${s.email}`}>{s.email}</a></div><button class="copy" type="button" data-copy={s.email} data-copied={L.copied} aria-label={`${L.copy} email address`}>{L.copy}</button><span class="copy-status" role="status" aria-live="polite"></span></div>
        <div class="crow"><div><small>{L.phone}</small><a href={`tel:${s.phoneHref}`}>{s.phoneDisplay}</a></div><button class="copy" type="button" data-copy={s.phoneDisplay} data-copied={L.copied} aria-label={`${L.copy} phone number`}>{L.copy}</button><span class="copy-status" role="status" aria-live="polite"></span></div>
        <div class="crow"><div><small>{L.whatsapp}</small><a href={s.whatsapp} target="_blank" rel="noopener">{L.whatsappText}<span class="sr-only"> (opens in a new tab)</span></a></div></div>
        <div class="crow"><div><small>{L.linkedin}</small><a href={s.linkedin} target="_blank" rel="noopener">{s.linkedinDisplay}<span class="sr-only"> (opens in a new tab)</span></a></div></div>
        <div class="crow"><div><small>{L.workingWith}</small><span class="v">{s.coverage.replace(/^I work with clients across the /, '').replace(/.$/, '')}</span></div></div>
      </div>
    </div>
  </section>

  <section class="band light" aria-labelledby="send-h">
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">Before you write</span>
        <h2 class="mini-h" id="send-h" style="margin-top:14px">{c.whatToSendTitle}</h2>
        <ul class="checklist">{c.whatToSend.map((w) => <li><span>{w}</span></li>)}</ul>
      </div>

      {formOn ? (
        <form class="formcard" id="enquiry" action="https://api.web3forms.com/submit" method="POST" novalidate data-w3={w3Key ? '1' : ''} data-sb-url={sbKey ? sbUrl : ''} data-sb-key={sbKey} data-region={region} data-sent={localise('Thank you, your message has been sent. I reply within one working day.')}>
          <h2>Send a message</h2>
          {w3Key && <input type="hidden" name="access_key" value={w3Key} />}
          <input type="hidden" name="subject" value="New enquiry from your website" />
          <input type="hidden" name="from_name" value="Lavi Bachchis website" />
          <div class="hp" aria-hidden="true"><label for="f-botcheck">Leave this empty</label><input id="f-botcheck" type="checkbox" name="botcheck" tabindex="-1" /></div>
          <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" autocomplete="name" maxlength="120" required /></div>
          <div class="field"><label for="f-email">Your email</label><input id="f-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
          <div class="field"><label for="f-biz">Business name and website</label><input id="f-biz" name="business" type="text" autocomplete="organization" maxlength="300" /></div>
          <div class="field"><label for="f-msg">Your message</label><textarea id="f-msg" name="message" maxlength="5000" required></textarea></div>
          <button class="btn" type="submit" style="justify-self:start">Send message</button>
          <p class="form-status" role="status" aria-live="polite"></p>
          <p class="form-note">{c.formNote} See the <a href={url('/privacy/')}>privacy note</a>.</p>
        </form>
      ) : (
        <div class="form-soon" id="enquiry">
          <b>Online form coming soon</b>
          <p>For now, the quickest way to reach me is by email at <a href={`mailto:${s.email}`}>{s.email}</a> or by phone on <a href={`tel:${s.phoneHref}`}>{s.phoneDisplay}</a> (a UK number). Outside the UK? <a href={s.whatsapp} rel="noopener" target="_blank">Message me on WhatsApp<span class="sr-only"> (opens in a new tab)</span></a> instead.</p>
          <a class="btn" style="justify-self:start" href={`mailto:${s.email}?subject=${encodeURIComponent('New project enquiry')}`}>Email me</a>
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  // Contact form: saves each enquiry in Supabase (insert-only) and emails it via Web3Forms.
  // Only says "sent" when at least one of them confirms success; never claims success otherwise.
  const form = document.querySelector<HTMLFormElement>('form#enquiry');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const { w3, sbUrl, sbKey, region } = form.dataset;

    const saveToSupabase = async (d: Record<string, string>) => {
      if (!sbUrl || !sbKey) return false;
      const res = await fetch(`${sbUrl}/rest/v1/contact_enquiries`, {
        method: 'POST',
        headers: { apikey: sbKey, Authorization: `Bearer ${sbKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({
          region, name: d.name, email: d.email, business: d.business || null,
          message: d.message, page: location.pathname.slice(0, 200),
        }),
      });
      return res.ok;
    };
    const emailViaWeb3Forms = async (d: Record<string, string>) => {
      if (!w3) return false;
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(d),
      });
      const data = await res.json().catch(() => ({}));
      return res.ok && data.success === true;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form-status';
      if (!form.checkValidity()) {
        status.classList.add('err');
        status.textContent = 'Please add your name, a valid email address and a message.';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
      // Spam trap: real people never tick the hidden box. Pretend success, send nothing.
      if (d.botcheck) { status.classList.add('ok'); status.textContent = form.dataset.sent || 'Thank you.'; form.reset(); return; }
      for (const k of ['name', 'email', 'business', 'message']) d[k] = (d[k] || '').trim();
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Sending…';
      const results = await Promise.allSettled([saveToSupabase(d), emailViaWeb3Forms(d)]);
      const ok = results.some((r) => r.status === 'fulfilled' && r.value === true);
      if (ok) {
        status.classList.add('ok');
        status.textContent = form.dataset.sent || 'Thank you, your message has been sent.';
        form.reset();
      } else {
        status.classList.add('err');
        status.textContent = 'Sorry, your message could not be sent. Please email hello@lavibachchis.com instead.';
      }
      btn.disabled = false;
      btn.textContent = label;
    });
  }
</script>
