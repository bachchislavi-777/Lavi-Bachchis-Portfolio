---
// Region chooser for lavibachchis.com/ and every pre-/uk-/us address (/about/, /work/solenne/ and so on,
// some of which Google has already indexed). Each one is a tiny page that sends the visitor to the same
// page under /uk/ or /us/:
//   1. a region they picked before with the UK | US switcher (localStorage 'lb-region'), else
//   2. US if their time zone is in the Americas (or their browser language is en-US), else UK.
// UK-only pages always go to /uk/. The canonical points at the UK version, so search engines treat these
// addresses as duplicates of it and pass their signals on. GitHub Pages can't redirect by IP on the server,
// which is why this runs in the browser.
import { getCollection } from 'astro:content';
import { ALL } from '../data/brands.js';
import { url, absUrl } from '../lib/url.js';
import { REGIONS, REGION_META } from '../lib/region.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const both = REGIONS;
  const pages = [
    ['', both], ['about', both], ['contact', both], ['privacy', both], ['services', both], ['work', both], ['insights', both],
    ...ALL.map((b) => [`work/${b.id}`, both]),
    ...posts.map((p) => [`insights/${p.id}`, p.data.regions]),
  ];
  return pages.map(([legacy, regions]) => ({ params: { legacy: legacy || undefined }, props: { regions } }));
}

const { regions } = Astro.props;
const path = `/${Astro.params.legacy ? `${Astro.params.legacy}/` : ''}`;
const site = Astro.site ?? new URL('https://lavibachchis.com');
const targets = Object.fromEntries(regions.map((r) => [r, url(path, { region: r })]));
const canonical = absUrl(path, site, { region: regions[0] });
const script = `(function(){var t=${JSON.stringify(targets)},r;
try{r=localStorage.getItem('lb-region')}catch(e){}
if(!t[r]){var z='',l=(navigator.language||'').toLowerCase();try{z=Intl.DateTimeFormat().resolvedOptions().timeZone||''}catch(e){}
r=/^(America|US|Canada)\\//.test(z)||z==='Pacific/Honolulu'||(!z&&l==='en-us')?'us':'uk';}
if(!t[r])r=${JSON.stringify(regions[0])};
location.replace(t[r]+location.search+location.hash);})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lavi Bachchis | Content & Creative</title>
    <link rel="canonical" href={canonical} />
    {regions.length > 1 && regions.map((r) => <link rel="alternate" hreflang={REGION_META[r].lang} href={absUrl(path, site, { region: r })} />)}
    {regions.length > 1 && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <script is:inline set:html={script} />
    <noscript><meta http-equiv="refresh" content={`0; url=${targets[regions[0]]}`} /></noscript>
    <style>body{font-family:system-ui,sans-serif;background:#163A2E;color:#FAF5E9;display:grid;place-items:center;min-height:100vh;margin:0}a{color:#E9B949;margin:0 .5em}</style>
  </head>
  <body>
    <p>Choose your site:
      {regions.map((r) => <a href={targets[r]} hreflang={REGION_META[r].lang}>{REGION_META[r].name}</a>)}
    </p>
  </body>
</html>
