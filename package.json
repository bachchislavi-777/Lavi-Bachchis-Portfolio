{
  "name": "lavi-bachchis-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website for Lavi Bachchis, freelance content & creative (London, UK & US clients).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "agreements:build": "node agreements/build.mjs",
    "agreements:local": "node agreements/build.mjs && node agreements/local/server.mjs",
    "agreements:test": "node agreements/build.mjs && node --test --test-concurrency=1 agreements/tests/core.test.mjs agreements/tests/api.test.mjs",
    "agreements:e2e": "node agreements/build.mjs && playwright test -c agreements/playwright.config.mjs",
    "agreements:demo": "node agreements/demo/build.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "astro": "^5.18.2",
    "pdfmake": "^0.2.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.28.2"
  }
}
