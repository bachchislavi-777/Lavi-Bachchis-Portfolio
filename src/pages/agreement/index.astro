---
// Client signing page. Each client gets a private link: lavibachchis.com/agreement/#<id>.<token>
import AppLayout from '../../layouts/AppLayout.astro';
import { CONTACT_EMAIL } from '../../../agreements/core/contact.js';
---
<AppLayout title="Your agreement | Lavi Bachchis" description="Read and sign your service agreement with Lavi Bachchis.">
  <div id="root"><div class="skeleton" aria-label="Loading"></div></div>
  <noscript><div class="center-msg"><h1>Please switch on JavaScript</h1><p>Signing needs JavaScript. Or email {CONTACT_EMAIL} for a paper copy.</p></div></noscript>
</AppLayout>
<script>
  import { mount } from '../../lib/agreements/sign-page.js';
  mount();
</script>
