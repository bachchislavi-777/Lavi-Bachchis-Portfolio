---
// Layout for the private, link-only pages: /agreement/, /invoice/ and /studio/.
// Not in the sitemap, never indexed, no regional prefix. The only outside address these pages may talk to is
// the agreements backend (Google Apps Script), which the content security policy allows explicitly.
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/caveat/600.css';
import '../styles/app.css';
import { AGREEMENTS_API_URL } from '../data/settings.js';

interface Props { title: string; description?: string; wide?: boolean }
const { title, description = '', wide = false } = Astro.props;
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const api = (import.meta.env.PUBLIC_AGREEMENTS_API || AGREEMENTS_API_URL || '').trim();
let apiOrigins = '';
try {
  if (api) {
    const u = new URL(api);
    // Apps Script answers from script.google.com and then script.googleusercontent.com (a redirect).
    apiOrigins = u.hostname === 'script.google.com' ? 'https://script.google.com https://script.googleusercontent.com' : u.origin;
  }
} catch { /* invalid address: pages show "not switched on" */ }
const csp = `default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'${apiOrigins ? ` ${apiOrigins}` : ''}; form-action 'none'; base-uri 'self'; object-src 'none'`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAF5E9" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${BASE}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${BASE}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${BASE}/apple-touch-icon.png`} />
    <script is:inline>try { if (window.top !== window.self) window.top.location.replace(window.self.location.href); } catch (e) { document.documentElement.style.display = 'none'; }</script>
    <meta name="lb-api" content={api} />
    <meta name="lb-base" content={BASE} />
  </head>
  <body class="app">
    <header class="app-top">
      <div class={`app-wrap${wide ? ' wide' : ''}`}>
        <a href={`${BASE}/`} class="app-logo"><img src={`${BASE}/brand/logo-horizontal.svg`} alt="Lavi Bachchis, Content & Creative" width="206" height="48" /></a>
        <slot name="top" />
      </div>
    </header>
    <main id="main" class={`app-wrap${wide ? ' wide' : ''}`}>
      <slot />
    </main>
    <footer class="app-foot">
      <div class={`app-wrap${wide ? ' wide' : ''}`}>
        <span>Lavi Bachchis · Content &amp; Creative · London</span>
        <span><a href="mailto:hello@lavibachchis.com">hello@lavibachchis.com</a> · <a href={`${BASE}/uk/privacy/`}>Privacy</a></span>
      </div>
    </footer>
  </body>
</html>
